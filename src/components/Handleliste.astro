---
import { formaterMengde, type Handleliste } from "../lib/handleliste";

interface Props {
  liste: Handleliste;
}

const { liste } = Astro.props;
const antall = liste.grupper.reduce((s, g) => s + g.linjer.length, 0);
---

<div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
  <div class="flex items-baseline justify-between">
    <h2 class="text-lg font-semibold">Handleliste</h2>
    <span class="text-sm text-stone-500">{antall} varer</span>
  </div>

  <div class="mt-4 text-sm">
    {liste.grupper.map(g => (
      <section class="mt-4 first:mt-0">
        <h3 class="text-xs font-semibold uppercase tracking-wide text-stone-500">{g.kategori}</h3>
        <ul class="mt-1 space-y-1">
          {g.linjer.map(l => (
            <li class="flex justify-between gap-3" title={`Til: ${l.til.join(", ")}`}>
              <span>{l.navn}</span>
              <span class="whitespace-nowrap text-stone-500">{formaterMengde(l.mengde, l.enhet)}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {liste.basis.length > 0 && (
      <section class="mt-5 border-t border-stone-100 pt-4">
        <h3 class="text-xs font-semibold uppercase tracking-wide text-amber-700">Har du dette hjemme?</h3>
        <ul class="mt-1 space-y-1 text-stone-600">
          {liste.basis.map(b => <li title={`Til: ${b.til.join(", ")}`}>{b.navn}</li>)}
        </ul>
      </section>
    )}
  </div>
</div>
