---
import RettKort from "./RettKort.astro";
import Handleliste from "./Handleliste.astro";
import Prosess from "./Prosess.astro";
import type { Uke } from "../lib/uker";

interface Props {
  uke: Uke;
}

const { uke } = Astro.props;
const s = uke.sunnhet;

const typeNavn: Record<string, string> = { fisk: "Fisk", kylling: "Kylling", kjøtt: "Kjøtt", egg: "Egg", vegetar: "Vegetar" };
const typeFarge: Record<string, string> = {
  fisk: "bg-sky-400", kylling: "bg-amber-400", kjøtt: "bg-rose-400", egg: "bg-yellow-400", vegetar: "bg-lime-500",
};

const maal = [
  {
    navn: "Fiskemiddager",
    verdi: `${s.fiskemiddager}`,
    ref: "Anbefalt: 2–3 i uka",
    ok: s.fiskemiddager >= 2,
  },
  {
    navn: "Rødt kjøtt per person",
    verdi: `${s.rodtKjottPerPerson} g`,
    ref: "Maks ca. 700 g rått i uka",
    ok: s.rodtKjottPerPerson <= 700,
  },
  {
    navn: "Grønnsaker per middag",
    verdi: `ca. ${s.grontPerPersonPerMiddag} g`,
    ref: "Per person. «5 om dagen» = 500 g frukt og grønt per dag",
    ok: s.grontPerPersonPerMiddag >= 150,
  },
  {
    navn: "Protein per porsjon",
    verdi: `ca. ${s.snittProtein} g`,
    ref: "Snitt for ukas middager",
    ok: s.snittProtein >= 25,
  },
];
---

<section>
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="text-2xl font-bold tracking-tight">{uke.tittel}</h2>
    {uke.eksempel && (
      <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800">Eksempel</span>
    )}
  </div>
  <p class="mt-1 text-stone-600">
    {s.middager} middager · {uke.porsjoner} porsjoner per middag · ca. {uke.minutter} min matlaging totalt
  </p>
  {uke.notat && <p class="mt-2 text-sm text-stone-500">{uke.notat}</p>}

  <div class="mt-6">
    <Prosess status={uke.status} />
  </div>

  <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_22rem]">
    <div>
      <h3 class="text-lg font-semibold">Middagene</h3>
      <div class="mt-3 grid gap-4 sm:grid-cols-2">
        {uke.middager.map(m => <RettKort rett={m.rett} dager={m.dager} />)}
      </div>
    </div>
    <aside class="lg:sticky lg:top-6 lg:self-start">
      <Handleliste liste={uke.handleliste} />
    </aside>
  </div>

  <div class="mt-10 rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
    <h3 class="text-lg font-semibold">Sunnhet denne uka</h3>
    <p class="mt-1 text-xs text-stone-500">
      Veiledende, og bare middagene. Referanser fra Helsedirektoratets kostråd.
    </p>

    <div class="mt-4 grid gap-3 sm:grid-cols-4">
      {maal.map(m => (
        <div class="rounded-xl bg-krem p-4">
          <div class="text-sm text-stone-600">{m.navn}</div>
          <div class="mt-1 flex items-center gap-2 text-2xl font-bold">
            {m.verdi}
            <span class:list={["text-base", m.ok ? "text-gronn" : "text-amber-600"]} aria-label={m.ok ? "Innenfor" : "Utenfor"}>
              {m.ok ? "✓" : "!"}
            </span>
          </div>
          <div class="mt-1 text-xs text-stone-500">{m.ref}</div>
        </div>
      ))}
    </div>

    <div class="mt-5">
      <div class="text-sm text-stone-600">Fordeling</div>
      <div class="mt-2 flex h-3 overflow-hidden rounded-full bg-stone-100">
        {s.fordeling.map(f => (
          <div class={typeFarge[f.type]} style={`width:${(f.antall / s.middager) * 100}%`} title={`${typeNavn[f.type]}: ${f.antall}`}></div>
        ))}
      </div>
      <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-stone-600">
        {s.fordeling.map(f => (
          <span class="flex items-center gap-1.5">
            <span class:list={["inline-block size-2.5 rounded-full", typeFarge[f.type]]}></span>
            {typeNavn[f.type]} {f.antall}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
