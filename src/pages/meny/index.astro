---
import Layout from "../../layouts/Layout.astro";
import { retter, fasteVarer } from "../../data/retter";

export const prerender = false;
---

<Layout title="Ukesmeny – Pakket" bred>
  <header class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <a href="/" class="text-sm font-semibold uppercase tracking-wide text-gronn">Pakket</a>
      <h1 class="text-3xl font-bold tracking-tight">Ukesmeny</h1>
    </div>
    <label class="flex items-center gap-2 text-sm">
      Porsjoner per middag
      <input id="porsjoner" type="number" min="1" max="12" value="3"
        class="w-16 rounded-md border border-stone-300 bg-white px-2 py-1 text-base" />
    </label>
  </header>

  <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_22rem]">
    <section>
      <h2 class="text-lg font-semibold">Velg retter <span id="antall" class="font-normal text-stone-500"></span></h2>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        {retter.map(rett => (
          <label class="flex cursor-pointer gap-3 rounded-xl border border-stone-200 bg-white p-4 shadow-sm transition has-[:checked]:border-gronn has-[:checked]:ring-2 has-[:checked]:ring-gronn/30">
            <input type="checkbox" class="rett mt-1 size-4 accent-gronn" value={rett.id} />
            <span>
              <span class="block font-medium leading-snug">{rett.navn}</span>
              <span class="mt-1 block text-sm text-stone-500">
                {rett.minutter} min · ca. {rett.proteinPerPorsjon} g protein
              </span>
              <span class="mt-2 flex flex-wrap gap-1">
                {rett.merker.map(m => (
                  <span class="rounded-full bg-stone-100 px-2 py-0.5 text-xs text-stone-600">{m}</span>
                ))}
              </span>
            </span>
          </label>
        ))}
      </div>

      <h2 class="mt-10 text-lg font-semibold">Faste varer</h2>
      <div class="mt-3 flex flex-wrap gap-2">
        {fasteVarer.map(v => (
          <label class="cursor-pointer rounded-full border border-stone-300 bg-white px-3 py-1 text-sm has-[:checked]:border-gronn has-[:checked]:bg-gronn has-[:checked]:text-white">
            <input type="checkbox" class="fast sr-only" value={v.navn} />
            {v.navn}
          </label>
        ))}
      </div>
    </section>

    <aside class="lg:sticky lg:top-6 lg:self-start">
      <div class="rounded-xl border border-stone-200 bg-white p-5 shadow-sm">
        <div class="flex items-center justify-between gap-2">
          <h2 class="text-lg font-semibold">Handleliste</h2>
          <div class="flex gap-2">
            <button id="nullstill" type="button" class="rounded-md px-2 py-1 text-sm text-stone-500 hover:text-stone-800">Nullstill</button>
            <button id="kopier" type="button" class="rounded-md bg-gronn px-3 py-1 text-sm font-medium text-white hover:opacity-90">Kopier</button>
          </div>
        </div>
        <div id="liste" class="mt-4 text-sm"></div>
        <p id="sammendrag" class="mt-4 border-t border-stone-100 pt-3 text-xs text-stone-500"></p>
      </div>
    </aside>
  </div>
</Layout>

<script>
  import { retter, fasteVarer } from "../../data/retter";
  import { lagHandleliste, somTekst, formaterMengde, type Handleliste } from "../../lib/handleliste";

  const LAGRING = "pakket-valg";
  const porsjonerFelt = document.getElementById("porsjoner") as HTMLInputElement;
  const rettBokser = [...document.querySelectorAll<HTMLInputElement>("input.rett")];
  const fastBokser = [...document.querySelectorAll<HTMLInputElement>("input.fast")];
  const listeEl = document.getElementById("liste")!;
  const sammendragEl = document.getElementById("sammendrag")!;
  const antallEl = document.getElementById("antall")!;
  const kopierKnapp = document.getElementById("kopier") as HTMLButtonElement;
  let gjeldende: Handleliste | null = null;

  const esc = (s: string) => s.replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  function hentLagret() {
    try {
      const data = JSON.parse(localStorage.getItem(LAGRING) ?? "null");
      if (!data) return;
      porsjonerFelt.value = String(data.porsjoner ?? 3);
      rettBokser.forEach(b => (b.checked = data.retter?.includes(b.value)));
      fastBokser.forEach(b => (b.checked = data.faste?.includes(b.value)));
    } catch {}
  }

  function lagre() {
    try {
      localStorage.setItem(LAGRING, JSON.stringify({
        porsjoner: Number(porsjonerFelt.value),
        retter: rettBokser.filter(b => b.checked).map(b => b.value),
        faste: fastBokser.filter(b => b.checked).map(b => b.value),
      }));
    } catch {}
  }

  function oppdater() {
    const porsjoner = Math.max(1, Number(porsjonerFelt.value) || 3);
    const valgte = retter.filter(r => rettBokser.some(b => b.checked && b.value === r.id));
    const faste = fasteVarer.filter(v => fastBokser.some(b => b.checked && b.value === v.navn));
    gjeldende = lagHandleliste(valgte, porsjoner, faste);
    antallEl.textContent = valgte.length ? `(${valgte.length} valgt)` : "";

    if (!valgte.length && !faste.length) {
      listeEl.innerHTML = `<p class="text-stone-500">Kryss av retter, så lages handlelisten her.</p>`;
      sammendragEl.textContent = "";
    } else {
      const grupper = gjeldende.grupper.map(g => `
        <h3 class="mt-4 first:mt-0 text-xs font-semibold uppercase tracking-wide text-stone-500">${esc(g.kategori)}</h3>
        <ul class="mt-1 space-y-1">
          ${g.linjer.map(l => `
            <li class="flex justify-between gap-3" title="Til: ${esc(l.til.join(", "))}">
              <span>${esc(l.navn)}</span>
              <span class="whitespace-nowrap text-stone-500">${esc(formaterMengde(l.mengde, l.enhet))}</span>
            </li>`).join("")}
        </ul>`).join("");
      const basis = gjeldende.basis.length ? `
        <h3 class="mt-5 text-xs font-semibold uppercase tracking-wide text-amber-700">Har du dette hjemme?</h3>
        <ul class="mt-1 space-y-1 text-stone-600">
          ${gjeldende.basis.map(b => `<li title="Til: ${esc(b.til.join(", "))}">${esc(b.navn)}</li>`).join("")}
        </ul>` : "";
      listeEl.innerHTML = grupper + basis;

      const minutter = valgte.reduce((sum, r) => sum + r.minutter, 0);
      const protein = valgte.length ? Math.round(valgte.reduce((s, r) => s + r.proteinPerPorsjon, 0) / valgte.length) : 0;
      const varer = gjeldende.grupper.reduce((s, g) => s + g.linjer.length, 0);
      sammendragEl.textContent = valgte.length
        ? `${varer} varer · ${minutter} min matlaging totalt · snitt ca. ${protein} g protein per porsjon`
        : `${varer} varer`;
    }
    lagre();
  }

  kopierKnapp.addEventListener("click", async () => {
    if (!gjeldende) return;
    try {
      await navigator.clipboard.writeText(somTekst(gjeldende));
      kopierKnapp.textContent = "Kopiert ✓";
    } catch {
      kopierKnapp.textContent = "Kunne ikke kopiere";
    }
    setTimeout(() => (kopierKnapp.textContent = "Kopier"), 1500);
  });

  document.getElementById("nullstill")!.addEventListener("click", () => {
    [...rettBokser, ...fastBokser].forEach(b => (b.checked = false));
    oppdater();
  });

  [porsjonerFelt, ...rettBokser, ...fastBokser].forEach(el => el.addEventListener("input", oppdater));

  hentLagret();
  oppdater();
</script>
