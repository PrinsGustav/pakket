---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  bred?: boolean;
}

const { title, description = "AI-assistert ukeshandel: ukesmeny, handleliste og Oda-handlekurv, med manuell godkjenning.", bred = false } = Astro.props;
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="min-h-screen bg-krem text-stone-800 antialiased">
    <main class:list={["mx-auto px-4", bred ? "max-w-5xl py-8" : "max-w-2xl py-16"]}>
      <slot />
    </main>
  </body>
</html>
